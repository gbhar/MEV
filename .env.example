# Copy to .env. No private keys exist in V1: the platform only reads the chain.
MEV_RPC_HTTP=https://base-rpc.publicnode.com
# https://mainnet.base.org also works but allows only 5 requests/s (the loop needs 3 per block plus polling).
# Optional. A paid provider (Alchemy, QuickNode, etc.) gives better latency and rate limits.
# MEV_RPC_WS=wss://...
MEV_DATABASE_URL=sqlite:///mev.db
# MEV_DATABASE_URL=postgresql+psycopg://mev:mev@localhost:5432/mev
MEV_METRICS_PORT=9100

# Laptop agent alerts (make agent). Webhook: Slack incoming webhook, Discord webhook, or
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
# MEV_ALERT_WEBHOOK=
# Optional LLM assessment through an OpenAI-compatible endpoint (NVIDIA NIM by default). Off until the key is set.
# MEV_LLM_API_KEY=nvapi-...
# MEV_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# MEV_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
