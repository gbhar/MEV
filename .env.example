# Copy to .env. The platform only reads the chain unless MEV_EXECUTION_MODE is shadow or live (see the end).
MEV_RPC_HTTP=https://base-rpc.publicnode.com
# https://mainnet.base.org also works but allows only 5 requests/s (the loop needs 3 per block plus polling).
# Optional. A paid provider (Alchemy, QuickNode, etc.) gives better latency and rate limits.
# MEV_RPC_WS=wss://...
MEV_DATABASE_URL=sqlite:///mev.db
# MEV_DATABASE_URL=postgresql+psycopg://mev:mev@localhost:5432/mev
MEV_METRICS_PORT=9100

# Laptop agent alerts (make agent). Webhook: Slack incoming webhook, Discord webhook, or
# https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
# MEV_ALERT_WEBHOOK=
# Optional LLM assessment through an OpenAI-compatible endpoint (NVIDIA NIM by default). Off until the key is set.
# MEV_LLM_API_KEY=nvapi-...
# MEV_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# MEV_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Execution (spec Phases 5-7). Default paper: nothing is built or sent. shadow: the FlashArb transaction is built
# and eth_call-simulated at head, never sent. live: signed and sent under the caps (needs the contract and the signer).
# MEV_EXECUTION_MODE=paper
# MEV_FLASH_ARB_ADDRESS=            # make contract-deploy prints it
# MEV_FLASH_LENDER=aave_v3          # or morpho_blue (fee-free)
# MEV_SIGNER_KEY is NOT set here: it lives in the Kubernetes secret mev-signer (make wallet) or a mode-600 file
# MEV_SIGNER_KEY_FILE=~/.mev-signer.key
# MEV_LIVE_MAX_TRADE_SIZE_USD=1000
# MEV_LIVE_MAX_DAILY_LOSS_USD=20
# MEV_LIVE_PAIR_ALLOWLIST=WETH/USDC,VIRTUAL/WETH,AERO/WETH
# MEV_EXECUTION_HALT=false          # kill switch (also: a HALT file, or `make halt`)
